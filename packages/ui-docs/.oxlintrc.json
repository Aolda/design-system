{
  "jsPlugins": ["../../lint/aolda-plugin.js"],
  "plugins": ["eslint", "typescript"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "aolda/no-tailwind-dark-variant": "error",
    "aolda/no-primitive-colors": "error",
    "aolda/no-cross-package-imports": "error",
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/no-unnecessary-template-expression": "off",
    "typescript/no-unnecessary-type-assertion": "off"
  }
}
