---
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";
import { HomeGrid } from "../components/demos/HomeGrid";
---

<MainLayout
  title="Aolda UI"
  description="Aolda UI – a modern component library for Aolda Cloud"
>
  <div class="flex flex-col">
    <Header />
    <main class="flex grow flex-col md:pr-12">
      <div
        class="mx-auto w-full grow md:border-r md:border-aolda-hairline"
      >
        <HomeGrid client:only="react" />
      </div>
    </main>
  </div>
</MainLayout>
