---
interface Props {
  title: string;
  description: string;
  href: string;
}

const { title, description, href } = Astro.props;
---

<div class="rounded-lg border border-aolda-hairline bg-aolda-elevated">
  <div class="p-4">
    <div class="text-aolda-default">{title}</div>
    <div class="mt-1 text-sm text-aolda-subtle">{description}</div>

    <div class="mt-4">
      <a
        href={href}
        class="inline-flex items-center justify-center rounded-md border border-aolda-hairline bg-aolda-control px-3 py-1.5 text-sm font-medium text-aolda-default transition-colors hover:bg-aolda-recessed"
      >
        Learn more
      </a>
    </div>
  </div>

  <div class="border-aolda-hairline border-t bg-aolda-base p-2">
    <slot />
  </div>
</div>
